<Window x:Class="MyAutoDNS.UI.FenetreTestEmail"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Test SMTP"
        Width="720"
        Height="540"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="Transparent"
        Foreground="{StaticResource Texte}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True">

    <Border Margin="14"
            Background="{StaticResource Fond}"
            BorderBrush="{StaticResource Bordure}"
            BorderThickness="1"
            CornerRadius="12">

        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.5" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- En-tete -->
            <Border Grid.Row="0"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Bordure}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="EnTete_MouseLeftButtonDown">

                <Grid Margin="20,12,10,12">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Test SMTP — déroulement" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Chaque étape est horodatée et recopiée dans logs\smtp_test.log"
                                   FontSize="11"
                                   Foreground="{StaticResource TexteSecondaire}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Button Content="✕"
                            Style="{StaticResource BoutonFantome}"
                            Width="32" Height="28" Padding="0" FontSize="13"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            ToolTip="Fermer"
                            Click="SurFermer" />
                </Grid>
            </Border>

            <!-- Journal -->
            <TextBox x:Name="ZoneLog"
                     Grid.Row="1"
                     Style="{StaticResource ZoneLog}"
                     Margin="20,16,20,0" />

            <!-- Actions -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Margin="20,14,20,18">
                <Button x:Name="BoutonRelancer"
                        Content="Relancer le test"
                        Style="{StaticResource BoutonAccent}"
                        Margin="0,0,8,0"
                        Click="SurRelancer" />
                <Button Content="Fermer"
                        Style="{StaticResource BoutonSecondaire}"
                        IsCancel="True"
                        Click="SurFermer" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
