<Window x:Class="MyAutoDNS.UI.FenetrePrincipale"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyAutoDNS — Configuration"
        Width="640"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="#F7F7F9">

    <StackPanel Margin="22">

        <!-- ================= En-tete ================= -->
        <TextBlock Text="MyAutoDNS" FontSize="21" FontWeight="SemiBold" />
        <TextBlock Text="Mise à jour automatique du nom de domaine"
                   Foreground="#666666" Margin="0,2,0,18" />

        <!-- ================= Adresse ================= -->
        <TextBlock Text="Adresse de mise à jour" Style="{StaticResource Etiquette}" />
        <TextBox x:Name="ChampUrl"
                 Padding="6,5"
                 VerticalContentAlignment="Center" />
        <TextBlock Style="{StaticResource Aide}"
                   Text="Adresse complète fournie par le fournisseur DDNS, menu « Direct URL ». Elle contient un jeton personnel : ne la diffuse pas." />

        <!-- ================= Frequence ================= -->
        <TextBlock Text="Fréquence des mises à jour" Style="{StaticResource Etiquette}" />
        <StackPanel Orientation="Horizontal">
            <TextBox x:Name="ChampIntervalle"
                     Width="90"
                     Padding="6,5"
                     VerticalContentAlignment="Center"
                     TextChanged="SurIntervalleModifie" />
            <ComboBox x:Name="ChoixUnite"
                      Width="130"
                      Margin="8,0,0,0"
                      VerticalContentAlignment="Center"
                      SelectedIndex="0"
                      SelectionChanged="SurUniteModifiee">
                <ComboBoxItem Content="minutes" />
                <ComboBoxItem Content="heures" />
            </ComboBox>
        </StackPanel>
        <TextBlock x:Name="TexteResumeIntervalle" Style="{StaticResource Aide}" />

        <!-- ================= Demarrage ================= -->
        <CheckBox x:Name="CaseDemarrerAvecWindows"
                  Content="Démarrer avec Windows"
                  FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Aide}"
                   Margin="22,4,0,16"
                   Text="Ajoute l'icône près de l'horloge à l'ouverture de session. Le service de mise à jour, lui, démarre de toute façon avec la machine." />

        <!-- ================= Etat ================= -->
        <Border Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="4"
                Padding="14"
                Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="État" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock x:Name="TexteEtatService" Text="…" />
                <TextBlock x:Name="TexteDerniereLigne"
                           Foreground="#666666"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- ================= Actions ================= -->
        <StackPanel Orientation="Horizontal">
            <Button x:Name="BoutonEnregistrer"
                    Content="Enregistrer et appliquer"
                    Style="{StaticResource Bouton}"
                    Click="SurEnregistrer" />
            <Button x:Name="BoutonMiseAJour"
                    Content="Mettre à jour maintenant"
                    Style="{StaticResource Bouton}"
                    Margin="8,0,0,0"
                    Click="SurMiseAJourImmediatee" />
            <Button x:Name="BoutonJournal"
                    Content="Ouvrir le journal"
                    Style="{StaticResource Bouton}"
                    Margin="8,0,0,0"
                    Click="SurOuvrirJournal" />
            <Button Content="Fermer"
                    Style="{StaticResource Bouton}"
                    Margin="8,0,0,0"
                    IsCancel="True"
                    Click="SurFermer" />
        </StackPanel>

        <!-- ================= Message ================= -->
        <TextBlock x:Name="TexteStatut"
                   Margin="0,14,0,0"
                   TextWrapping="Wrap"
                   FontSize="12" />

    </StackPanel>
</Window>
