<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="MyAutoDNS.UI.app" />

  <!--
    L'interface demande l'elevation pour trois raisons, toutes indispensables :
      - elle ecrit settings.json dans C:\ProgramData\MyAutoDNS, ou un utilisateur
        standard n'a pas le droit d'ecrire ;
      - elle cree et pilote les taches planifiees, dont celle de l'agent qui
        s'execute sous le compte SYSTEM ;
      - le Planificateur refuse d'enregistrer une tache RunLevel HighestAvailable
        sans droits d'administration (verifie sur ce poste : « Acces refuse »).
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 et 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
