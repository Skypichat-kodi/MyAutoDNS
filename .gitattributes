# Normalisation des fins de ligne.
# Le projet ne contient que du code Windows : les .bat et les .iss en particulier
# DOIVENT rester en CRLF, sinon cmd.exe et Inno Setup les interpretent mal.

* text=auto eol=crlf

*.cs       text eol=crlf
*.csproj   text eol=crlf
*.sln      text eol=crlf
*.bat      text eol=crlf
*.iss      text eol=crlf
*.xaml     text eol=crlf
*.json     text eol=crlf
*.md       text eol=crlf

*.png      binary
*.ico      binary
*.exe      binary
