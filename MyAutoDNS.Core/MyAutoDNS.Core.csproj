<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net8.0-windows et non net8.0 : le logiciel est Windows par nature
      (taches planifiees, DPAPI, dossiers ProgramData). Le ciblage Windows est
      aussi ce qui autorise l'usage de ProtectedData sans avertissement.
      Cela n'ajoute aucune dependance au runtime : seuls les assemblies
      Microsoft.NETCore.App restent necessaires.
    -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MyAutoDNS.Core</RootNamespace>
    <AssemblyName>MyAutoDNS.Core</AssemblyName>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Chiffrement DPAPI du mot de passe SMTP. Ce n'est pas dans le framework
      partage : le package officiel Microsoft est necessaire. Il ne sert que sur
      Windows, ce qui est le cas de cette application.
    -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
