<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net8.0-windows et non net8.0 : le logiciel est Windows par nature
      (taches planifiees, DPAPI, dossiers ProgramData). Le ciblage Windows est
      aussi ce qui autorise l'usage de ProtectedData sans avertissement.
      Cela n'ajoute aucune dependance au runtime : seuls les assemblies
      Microsoft.NETCore.App restent necessaires.
    -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MyAutoDNS.Core</RootNamespace>
    <AssemblyName>MyAutoDNS.Core</AssemblyName>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!--
      MailKit : envoi SMTP. Remplace System.Net.Mail, qui n'envoie pas
      l'authentification si le serveur ne l'annonce pas dans sa banniere EHLO
      (refus OFR_402 d'Orange), et qui ne sait pas negocier le SSL implicite
      du port 465.

      System.Security.Cryptography.ProtectedData : chiffrement DPAPI du mot de
      passe. Ce n'est pas dans le framework partage.
    -->
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
